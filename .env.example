NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxx

# Server-only — bypasses RLS. Needed for invite acceptance and the /admin panel.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=xxxx

# WhatsApp personnel (open-wa) — see whatsapp-service/README.md
WHATSAPP_SERVICE_URL=http://localhost:8099
WHATSAPP_SERVICE_API_KEY=xxxx

# SasPay (facturation par organisation) — clé secrète du tableau de bord SasPay.
SASPAY_SECRET_KEY=sk_test_xxxx
# Secret de signature des webhooks, donné une seule fois à la création/rotation dans le tableau de bord SasPay.
SASPAY_WEBHOOK_SECRET=xxxx

# Secret du cron Vercel (voir vercel.json) — Vercel l'envoie automatiquement en
# "Authorization: Bearer $CRON_SECRET" quand cette variable est définie sur le projet.
CRON_SECRET=xxxx